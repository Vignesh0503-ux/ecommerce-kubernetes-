# Copy this file to .env and adjust if your services run on different ports.
# These are read at build/dev time by Vite (must be prefixed with VITE_).

VITE_USER_SERVICE_URL=http://localhost:8081
VITE_PRODUCT_SERVICE_URL=http://localhost:8082
VITE_ORDER_SERVICE_URL=http://localhost:8083
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8084
